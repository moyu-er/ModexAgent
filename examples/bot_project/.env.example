# Bot Project Environment Variables
# Copy this file to .env and fill in your actual values.

# Timezone for timestamps (IANA zone name or UTC offset)
TIMEZONE=Asia/Shanghai

# QQ Bot credentials
QQ_APP_ID=your_qq_app_id
QQ_SECRET=your_qq_bot_secret

# LLM model settings are NOT here — they live in config/model.yml
# (edit with `modexbot config`). Copy config/model.example.yml to start.

# MCP servers — ModelScope SSE endpoints (shared Bearer token)
MCP_BEARER_TOKEN=your_modelscope_bearer_token

# MiniMax MCP coding tool (separate from main LLM; only needed if using minimax-coding-plan-mcp)
MINIMAX_MCP_API_KEY=your_minimax_api_key
