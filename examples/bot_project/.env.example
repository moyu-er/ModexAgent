# Bot Project Environment Variables
# Copy this file to .env and fill in your actual values.

# Timezone for timestamps (IANA zone name or UTC offset)
TIMEZONE=Asia/Shanghai

# Langfuse observability (self-hosted, optional)
# Leave LANGFUSE_BASIC_AUTH empty to disable OTLP export (file-only fallback).
LANGFUSE_HOST=http://localhost:3000
# base64(pk:sk) — generate with: echo -n "pk-lf-xxx:sk-lf-xxx" | base64
# Get keys from Langfuse UI → Project → Settings → API Keys.
LANGFUSE_BASIC_AUTH=
