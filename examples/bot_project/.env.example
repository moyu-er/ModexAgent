# Bot Project Environment Variables
# Copy this file to .env and fill in your actual values.

# Timezone for timestamps (IANA zone name or UTC offset)
TIMEZONE=Asia/Shanghai

# Langfuse observability (self-hosted v4, optional)
# Default is otel_http — spans are OTLP-exported to the collector endpoint
# below. Set OTEL_FORMAT only to change it: file = file-only legacy fallback,
# off = tracing disabled. Example lines kept commented.
# OTEL_FORMAT=file
# OTEL_FORMAT=off
# Leaving LANGFUSE_BASIC_AUTH empty keeps otel_http on but sends an invalid
# "Basic " Authorization header — Langfuse rejects exports with 401. To fall
# back to local jsonl, explicitly set OTEL_FORMAT=file.
LANGFUSE_HOST=http://localhost:3000
# base64(pk:sk) — generate with: echo -n "pk-lf-xxx:sk-lf-xxx" | base64
# Get keys from Langfuse UI → Project → Settings → API Keys.
LANGFUSE_BASIC_AUTH=
# OTLP traces endpoint (collector). Unset or point at ${LANGFUSE_HOST}/api/public/otel/v1/traces to bypass the collector
# OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Eval CLI (python -m bot.eval.cli) — separate pk/sk from the OTLP BASIC_AUTH above
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
