{
  "id": "readonly-qa",
  "turns": [
    {
      "user": "Use the read tool to inspect data/metrics.txt. How many errors are recorded? Answer with the exact phrase `errors: 3` and do not modify or create any files.",
      "expected_stop": "completed"
    }
  ],
  "toolset": "read_only",
  "deny_tools": [
    "bash"
  ],
  "world_setup": {
    "data/metrics.txt": "requests=120\nerrors=3\nlatency_ms=45\n"
  },
  "world_assertions": [
    {
      "kind": "file_absent",
      "path": "data/metrics.bak"
    },
    {
      "kind": "file_contains",
      "path": "data/metrics.txt",
      "content": "requests=120"
    }
  ]
}
